# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for production.
# (.env* files are git-ignored; this example is committed via the ! rule.)

# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for in-app account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cover identification (Anthropic) ──────────────────────────────
ANTHROPIC_API_KEY=
# Models to try, cheapest first; the next one is used only if the previous
# fails, can't read the cover, or isn't confident. Any Claude model id works.
VISION_MODELS=claude-haiku-4-5,claude-sonnet-5-5
# Models used when the owner taps "Wrong Album — Ask Again" or sends a hint.
# Defaults to every model in VISION_MODELS after the first.
VISION_RETRY_MODELS=claude-sonnet-5-5
# Cover scans per user per rolling 24 hours.
IDENTIFY_DAILY_LIMIT=40

# ── Discogs (discogs.com/settings/developers → personal access token) ──
DISCOGS_TOKEN=

# ── Public site settings ──────────────────────────────────────────
# Where share links, the privacy policy and support page live.
NEXT_PUBLIC_SITE_URL=https://wax-cabinet.vercel.app
# Collection shown to signed-out visitors of the website (a user id from
# Supabase → Authentication → Users). Leave empty to show the welcome screen.
NEXT_PUBLIC_FEATURED_OWNER=
# Shown on the privacy and support pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── iOS build only (scripts/build-ios.sh sets these) ──────────────
# NEXT_PUBLIC_API_BASE=https://wax-cabinet.vercel.app
